+    public void SetFullscreenMono(bool enabled)
+    {
+        fullscreenMono = enabled;
+        if (remoteCameraWindow != null && remoteCameraWindow.RemoteCameraImage != null)
+        {
+            // The legacy RawImage is a second copy behind the per-eye canvases.
+            // Do not stack both display paths in full-scene mode.
+            remoteCameraWindow.RemoteCameraImage.enabled = !enabled;
+        }
+        ApplyFullscreenMono(matLE, enabled);
+        ApplyFullscreenMono(matRE, enabled);
+
+        // These are Screen Space - Camera canvases, one per eye. Draw them after
+        // the normal control panel so the camera becomes the complete XR scene.
+        foreach (GameObject canvasObject in new[] { CanvLE, CanvRE })
+        {
+            if (canvasObject == null) continue;
+            Canvas canvas = canvasObject.GetComponent<Canvas>();
+            if (canvas == null) continue;
+            canvas.overrideSorting = enabled;
+            canvas.sortingOrder = enabled ? 1000 : 0;
+            // Keep the video plane well away from the XR cameras' near-clip
+            // boundary. The old 0.31 m plane was only 4 cm inside the B-button
+            // 0.35 m clip value and flickered as the per-eye projection updated.
+            canvas.planeDistance = enabled
+                ? FullscreenPlaneDistance
+                : LegacyPlaneDistance;
+        }
+        Debug.Log($"Remote camera fullscreen mono: {enabled}");
+    }
+
+    private static void ApplyFullscreenMono(Material material, bool enabled)
+    {
+        if (material != null)
+        {
+            material.SetFloat("_fullscreenMono", enabled ? 1f : 0f);
+        }
+    }
     
